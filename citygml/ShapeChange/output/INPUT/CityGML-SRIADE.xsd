      <extension base="gml:AbstractFeatureType">
        <sequence>
          <element name="version" type="integer"/>
          <element name="description" type="string"/>
          <element maxOccurs="unbounded" minOccurs="0" name="isPartOfCatalogue" type="SRIADE:SRIServicePropertyType">
            <annotation>
              <appinfo>
                <sc:taggedValue tag="maxOccurs">*</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
  <complexType name="ServiceCataloguePropertyType">
    <sequence minOccurs="0">
      <element ref="SRIADE:ServiceCatalogue"/>
    </sequence>
    <attributeGroup ref="gml:AssociationAttributeGroup"/>
  </complexType>
